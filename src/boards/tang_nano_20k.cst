// Sipeed Tang Nano 20K (GW2AR-LV18QN88C8/I7)
IO_LOC "clk_27m" 4;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// S1: active high
IO_LOC "rst_btn" 88;
IO_PORT "rst_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// BL616 USB-UART bridge
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs, active low
IO_LOC "led_n[0]" 15;
IO_LOC "led_n[1]" 16;
IO_LOC "led_n[2]" 17;
IO_LOC "led_n[3]" 18;
IO_LOC "led_n[4]" 19;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;

// HDMI (DVI) output, differential (ELVDS_OBUF)
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE;
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE;
