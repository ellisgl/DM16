# Tang Console 138K - onboard Sipeed "USB Debugger" (FTDI FT2232, 0403:6010)
#   interface 00 = JTAG (used by openFPGALoader / Gowin programmer)
#   interface 01 = UART to the FPGA  ->  /dev/tang_console_uart
#
# Matches on properties set by the stock 60-serial.rules (usb_id), so the
# serial number and interface come from one consistent place. Numbered 85 so
# it runs after 80-fpga-ftdi.rules, which would otherwise reset MODE/GROUP.

SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6010", ENV{ID_SERIAL_SHORT}=="2025041420", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6010", ENV{ID_SERIAL_SHORT}=="2025041420", ENV{ID_USB_INTERFACE_NUM}=="01", SYMLINK+="tang_console_uart"
